# Copy these into your hosting settings (Netlify → Site configuration → Environment variables).
# Never put the real values in GitHub.

NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Stripe → Developers → API keys (start with the TEST keys: sk_test_...)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
